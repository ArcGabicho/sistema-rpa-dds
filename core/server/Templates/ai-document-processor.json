{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.47.16.16243",
      "templateHash": "3418620578436367242"
    }
  },
  "parameters": {
    "serviceName": {
      "type": "string",
      "metadata": {
        "description": "Nombre lógico del servicio, usado como prefijo de los recursos."
      }
    },
    "storageContainer": {
      "type": "string",
      "defaultValue": "documents",
      "metadata": {
        "description": "Nombre del contenedor de Blob Storage donde se leen/escriben los documentos."
      }
    },
    "model": {
      "type": "string",
      "defaultValue": "gpt-4o-mini",
      "metadata": {
        "description": "Modelo de IA a usar (p.ej. gpt-4o-mini)."
      }
    },
    "openaiKey": {
      "type": "securestring",
      "metadata": {
        "description": "API key del proveedor de IA (OpenAI o Azure OpenAI) que el usuario trae consigo."
      }
    },
    "containerAppsEnvironmentName": {
      "type": "string",
      "metadata": {
        "description": "Nombre del Container Apps Environment existente donde se despliega el servicio."
      }
    },
    "implementacionId": {
      "type": "string",
      "metadata": {
        "description": "Id de la implementación en la base de datos de la plataforma, usado solo para etiquetar recursos."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    }
  },
  "variables": {
    "namePrefix": "[toLower(replace(parameters('serviceName'), '-', ''))]",
    "uniqueSuffix": "[substring(uniqueString(resourceGroup().id, parameters('serviceName')), 0, 8)]",
    "storageAccountName": "[take(format('st{0}{1}', variables('namePrefix'), variables('uniqueSuffix')), 24)]",
    "containerAppName": "[format('ca-{0}-{1}', parameters('serviceName'), variables('uniqueSuffix'))]",
    "commonTags": {
      "dds-implementacion-id": "[parameters('implementacionId')]",
      "dds-template-id": "ai-document-processor"
    }
  },
  "resources": [
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2023-05-01",
      "name": "[variables('storageAccountName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Standard_LRS"
      },
      "kind": "StorageV2",
      "tags": "[variables('commonTags')]",
      "properties": {
        "minimumTlsVersion": "TLS1_2",
        "allowBlobPublicAccess": false
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices",
      "apiVersion": "2023-05-01",
      "name": "[format('{0}/{1}', variables('storageAccountName'), 'default')]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName'))]"
      ]
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices/containers",
      "apiVersion": "2023-05-01",
      "name": "[format('{0}/{1}/{2}', variables('storageAccountName'), 'default', parameters('storageContainer'))]",
      "properties": {
        "publicAccess": "None"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts/blobServices', variables('storageAccountName'), 'default')]"
      ]
    },
    {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2024-03-01",
      "name": "[variables('containerAppName')]",
      "location": "[parameters('location')]",
      "tags": "[union(variables('commonTags'), createObject('dds-role', 'compute'))]",
      "properties": {
        "environmentId": "[resourceId('Microsoft.App/managedEnvironments', parameters('containerAppsEnvironmentName'))]",
        "configuration": {
          "ingress": {
            "external": true,
            "targetPort": 8080
          },
          "secrets": [
            {
              "name": "openai-key",
              "value": "[parameters('openaiKey')]"
            },
            {
              "name": "storage-connection-string",
              "value": "[format('DefaultEndpointsProtocol=https;AccountName={0};AccountKey={1};EndpointSuffix=core.windows.net', variables('storageAccountName'), listKeys(resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName')), '2023-05-01').keys[0].value)]"
            }
          ]
        },
        "template": {
          "containers": [
            {
              "name": "app",
              "image": "mcr.microsoft.com/k8se/quickstart:latest",
              "resources": {
                "cpu": "[json('0.5')]",
                "memory": "1Gi"
              },
              "env": [
                {
                  "name": "OPENAI_API_KEY",
                  "secretRef": "openai-key"
                },
                {
                  "name": "MODEL",
                  "value": "[parameters('model')]"
                },
                {
                  "name": "STORAGE_CONTAINER",
                  "value": "[parameters('storageContainer')]"
                },
                {
                  "name": "STORAGE_CONNECTION_STRING",
                  "secretRef": "storage-connection-string"
                }
              ]
            }
          ],
          "scale": {
            "minReplicas": 1,
            "maxReplicas": 1
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName'))]"
      ]
    }
  ],
  "outputs": {
    "containerAppUrl": {
      "type": "string",
      "value": "[format('https://{0}', reference(resourceId('Microsoft.App/containerApps', variables('containerAppName')), '2024-03-01').configuration.ingress.fqdn)]"
    },
    "containerAppName": {
      "type": "string",
      "value": "[variables('containerAppName')]"
    },
    "storageAccountName": {
      "type": "string",
      "value": "[variables('storageAccountName')]"
    }
  }
}