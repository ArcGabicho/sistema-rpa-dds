# Copy this file to .env and fill in real values before running the stack.
# scripts/setup.sh does this for you interactively.

# --- Development database (local SQL Server in docker/docker-compose.yml) ---
# Password for the sa login of the local SQL Server container. It must meet
# SQL Server's policy (8+ characters, with upper, lower, digits or symbols).
# The volume keeps the first password it was created with: after changing
# it, run scripts/clear.sh to start the local database from scratch.
MSSQL_SA_PASSWORD=ChangeMe_S4Strong!
DB_PORT=1433
DEV_DB_NAME=db-rpa-dds

# --- Production database (Azure SQL Database) ---
# Not used by docker compose: set it on the platform that deploys the API, as
# ConnectionStrings__Default. Full ADO.NET connection string, wrapped in
# single quotes so characters like $ or # in the password are taken
# literally. Connection Timeout=60 gives a serverless (free) database time
# to resume from auto-pause. Format:
# 'Server=tcp:<servidor>.database.windows.net,1433;Initial Catalog=<base>;User ID=<usuario>;Password=<contraseña>;Encrypt=True;TrustServerCertificate=False;Connection Timeout=60;'
DB_CONNECTION_STRING=

# --- API (core/server) ---
ASPNETCORE_ENVIRONMENT=Production
SERVER_PORT=8080
# Symmetric signing key for login JWTs. Must be a long random string, and
# must match between the API and the client (used to verify the session).
# The website also signs the visitor's IP with it, so the API's rate limits
# apply per visitor and not to the website's server as a whole.
JWT_SECRET=ChangeMe_JWT_Secret_At_Least_32_Chars
JWT_EXPIRES_IN_MINUTES=60

# Master key of the vault (Bóveda), which encrypts the stored credentials and
# API keys: 32 random bytes in base64 — scripts/setup.sh generates it, or run
#   openssl rand -base64 32
# Keep a copy outside the server: without it the secrets can't be recovered,
# and changing it makes the existing ones unreadable.
BOVEDA_CLAVE_MAESTRA=

# Seeded on first run if no admin user exists yet.
ADMIN_EMAIL=admin@dds.pe
ADMIN_PASSWORD=ChangeMe_Admin123!
ADMIN_FULL_NAME=Administrador

# Local stack only: fill the empty development database with 4,018 fictitious
# companies, their contacts and a demo pipeline. Never on in production.
SEED_DATOS_DEMO=true

# --- Web (core/client) ---
CLIENT_PORT=3000
# Origin the API accepts CORS requests from.
CLIENT_ORIGIN=http://localhost:3000
# Public URL of the site (the Vercel deployment), used for the absolute URLs
# in Open Graph / Twitter card tags. If left empty, Vercel falls back to the
# project's production domain and local runs to http://localhost:<port>.
SITE_URL=https://sistema-rpa-dds.vercel.app
