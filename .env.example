# Copy this file to .env and fill in real values before running the stack.
# scripts/setup.sh does this for you interactively.

# --- Database (Azure SQL Database) ---
# Full ADO.NET connection string of the Azure SQL database, wrapped in single
# quotes so characters like $ or # in the password are taken literally. Use a
# dedicated contained user for the app, not the server admin.
# Connection Timeout=60 gives a serverless (free) database time to resume
# from auto-pause. Format:
# 'Server=tcp:<servidor>.database.windows.net,1433;Initial Catalog=<base>;User ID=<usuario>;Password=<contraseña>;Encrypt=True;TrustServerCertificate=False;Connection Timeout=60;'
DB_CONNECTION_STRING=

# --- API (core/server) ---
ASPNETCORE_ENVIRONMENT=Production
SERVER_PORT=8080
# Symmetric signing key for login JWTs. Must be a long random string, and
# must match between the API and the client (used to verify the session).
JWT_SECRET=ChangeMe_JWT_Secret_At_Least_32_Chars
JWT_EXPIRES_IN_MINUTES=60

# Seeded on first run if no admin user exists yet.
ADMIN_EMAIL=admin@dds.pe
ADMIN_PASSWORD=ChangeMe_Admin123!
ADMIN_FULL_NAME=Administrador

# --- Web (core/client) ---
CLIENT_PORT=3000
# Origin the API accepts CORS requests from.
CLIENT_ORIGIN=http://localhost:3000
