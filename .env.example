# Copy this file to .env and fill in real values before running docker compose.
# scripts/setup.sh does this for you interactively.

# --- SQL Server ---
# Bootstrap password for the built-in sa account. Only used once, by
# docker/database/init.sh, to create the application's own login below —
# the app itself never connects as sa.
MSSQL_SA_PASSWORD=ChangeMe_S4Strong!
DB_PORT=1433

# Dedicated login the API connects with (created by docker/database/init.sql).
APP_DB_NAME=DdsDb
APP_DB_USER=dds_app
APP_DB_PASSWORD=ChangeMe_AppUser!

# --- API (core/server) ---
ASPNETCORE_ENVIRONMENT=Production
SERVER_PORT=8080
# Symmetric signing key for login JWTs. Must be a long random string, and
# must match between the API and the client (used to verify the session).
JWT_SECRET=ChangeMe_JWT_Secret_At_Least_32_Chars
JWT_EXPIRES_IN_MINUTES=60

# Seeded on first run if no admin user exists yet.
ADMIN_EMAIL=admin@dds.pe
ADMIN_PASSWORD=ChangeMe_Admin123!
ADMIN_FULL_NAME=Administrador

# --- Web (core/client) ---
CLIENT_PORT=3000
# Origin the API accepts CORS requests from.
CLIENT_ORIGIN=http://localhost:3000

# --- Azure deployment (scripts/deploy.sh, infra/main.bicep) ---
# The secrets above are reused as-is for the cloud deployment (MSSQL_SA_PASSWORD
# becomes the Azure SQL server admin password, APP_DB_* the dedicated app
# login, JWT_SECRET/ADMIN_* the same as local). These only control naming.
AZURE_RESOURCE_GROUP=rg-dds
AZURE_LOCATION=eastus
AZURE_ENVIRONMENT_NAME=dds
SQL_ADMIN_LOGIN=ddsadmin
